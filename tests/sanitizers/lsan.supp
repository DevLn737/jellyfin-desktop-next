# LeakSanitizer suppressions for the sanitizer jobs (ci.yml). Only leaks whose
# whole stack is in an uninstrumented system library, allocated once per
# process; never our own code. LSAN_OPTIONS=suppressions=<this file>.

# libproxy (system proxy lookup behind QNetworkProxyFactory) keeps its
# GObject manager for the life of the process.
leak:libpxbackend-1.0.so
leak:libproxy.so
